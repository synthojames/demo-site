---
interface Props {
  title: string;
}
import '../styles/global.css';
const { title } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <nav>
        <a href="/" aria-current={path === '/' ? 'page' : undefined}>ホーム</a>
        <a href="/news" aria-current={path.startsWith('/news') ? 'page' : undefined}>お知らせ</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer><small>株式会社サンプルマーケット(デモサイト)</small></footer>
  </body>
</html>