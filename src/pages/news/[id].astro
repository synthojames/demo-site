---
import type {GetStaticPaths} from 'astro';
import Base from '../../layouts/Base.astro';
import {client} from '../../lib/sanity';

interface NewsItem {
  _id: string;
  title: string;
  publishedAt: string;
  body?: string;
}

interface Props {
  item: NewsItem;
}

export const getStaticPaths = (async () => {
  const items = await client.fetch<NewsItem[]>(
    `*[_type == "newsItem"]{_id, title, publishedAt, body}`,
  );
  return items.map((item) => ({
    params: {id: item._id},
    props: {item},
  }));
}) satisfies GetStaticPaths;

const {item} = Astro.props;
---
<Base title={`${item.title} | 株式会社サンプルマーケット`}>
  <p><a href="/news/">← お知らせ一覧</a></p>
  <h1>{item.title}</h1>
  <p>{item.publishedAt}</p>
  {item.body && <p style="white-space: pre-line">{item.body}</p>}
</Base>