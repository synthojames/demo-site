---
import Base from '../layouts/Base.astro';
import {client} from '../lib/sanity';

const page = await client.fetch(
  '*[_type == "page" && slug.current == $slug][0]{headline, body}',
  {slug: 'home'},
);

if (!page) {
  throw new Error('Sanity: published page "home" not found');
}
---
<Base title="株式会社サンプルマーケット">
  <h1>{page.headline}</h1>
  <p>{page.body}</p>
</Base>